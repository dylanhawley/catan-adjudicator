# OpenAI Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here

# Models (optional, these are the defaults)
# OPENAI_MODEL: answers questions
# CONDENSE_MODEL: rewrites follow-up questions into standalone search queries
# EMBEDDING_MODEL: embeds rulebook chunks and queries
OPENAI_MODEL=gpt-4o
CONDENSE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Number of rulebook chunks retrieved per question (optional)
RETRIEVAL_K=8

# Chroma Vector Store Configuration (optional)
CHROMA_PERSIST_DIR=./chroma_db

# Allowed CORS origins for the frontend, comma-separated (optional)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
